{{!
    @template theme_boost/login

    Mitema override for the Boost login page.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">
    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="container-fluid pt-0 mt-0 mitema-login-page">
        <div id="page-content" class="row g-0 min-vh-100 align-items-stretch mitema-login-shell">
            <aside class="col-lg-6 d-none d-lg-flex mitema-login-hero">
                <div class="mitema-login-hero__content">
                    <img src="/theme/mitema/pix/logo-cem.svg" class="mitema-login-hero__logo" alt="{{sitename}}">
                    <div class="mitema-login-hero__eyebrow">mitema // acceso</div>
                    <h1 class="mitema-login-hero__title">{{{ sitename }}}</h1>
                    <p class="mitema-login-hero__lead">Acceso al campus con identidad institucional clara y un layout mas limpio.</p>
                </div>
            </aside>
            <section class="col-12 col-lg-6 d-flex align-items-center justify-content-center mitema-login-stage">
                <div id="region-main-box" class="col-12 col-xl-9">
                    <div id="region-main" class="col-12 h-100">
                        <div class="login-wrapper mitema-login-wrapper">
                            <img src="/theme/mitema/pix/logo-cem.svg" class="mitema-login-mobile-logo d-lg-none" alt="{{sitename}}">
                            <div class="login-container mitema-login-container">
                                <div class="mitema-login-topline">bienvenido</div>
                                {{{ output.main_content }}}
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}